# ESPHome-Secrets (lokal ergänzt, nie einchecken)
firmware/secrets.yaml
secrets.yaml

# ESPHome-Build-Artefakte
.esphome/
*.bin
# ...aber die fertigen Release-Images in firmware/build/ werden mitgeführt
!firmware/build/*.bin

# Python
__pycache__/
*.pyc
.venv/
venv/

